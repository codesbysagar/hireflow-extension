{
  "name": "hireflow-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Chrome Extension to extract structured hiring information from LinkedIn search results",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build:popup": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build": "npm run build:popup && npm run build:scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
